{% extends 'base.html.twig' %}

{% block title %}Inscription - {{ parent() }}{% endblock %}

{% block header %}
    <h1>Inscription</h1>
{% endblock %}

{% block body %}

{{ form_start(form) }}

{{ form_row(form.nom) }}
{{ form_row(form.prenom) }}
{{ form_row(form.email) }}
{{ form_row(form.password) }}
{{ form_row(form.passwordConfirm) }}
<button class="button button-submit">Enregistrer</button>
{{ form_end(form) }}

{% endblock %}